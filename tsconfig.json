{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tui.tsx",
    "lib/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "test/host-contract.ts"
  ]
}
